VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000

# Optional self-hosted Protomaps basemap. Use either a same-origin path such as
# /maps/sibuyan.pmtiles or an HTTPS object-storage/CDN URL with Range and CORS support.
VITE_PMTILES_URL=

# Optional Terrarium-encoded DEM tiles. The default is the public Mapzen terrain
# dataset on AWS Open Data; override this with a controlled terrain endpoint.
VITE_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
