VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000

# Public Web Push application-server key. It must exactly match the server's
# VAPID_PUBLIC_KEY. This value is safe to expose and is embedded at build time.
VITE_VAPID_PUBLIC_KEY=

# Optional self-hosted Protomaps basemap. Use either a same-origin path such as
# /maps/sibuyan.pmtiles or an HTTPS object-storage/CDN URL. The host must return
# 206 Partial Content and expose Content-Range when requested cross-origin.
VITE_PMTILES_URL=

# Optional Terrarium-encoded DEM tiles. The default is the public Mapzen terrain
# dataset on AWS Open Data; override this with a controlled terrain endpoint.
VITE_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
