NODE_ENV=development
PORT=5000
# Emailed responder-invitation and password-reset links are built from this as
# <CLIENT_URL>/reset-password/<token>. It must be an absolute HTTP(S) URL the
# recipient's browser can reach: keep localhost for local development only and
# set the public client address in any shared or production environment.
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
# Optional bounded session lifetimes. Access JWT: 5-30 minutes; rotating
# refresh session: 1-30 days.
JWT_ACCESS_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=7

# Browser Web Push. Generate one VAPID pair and reuse its public key as the
# client's VITE_VAPID_PUBLIC_KEY. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:alerts@example.com
VITE_VAPID_PUBLIC_KEY=

# Optional email delivery (password resets AND responder invitations).
# When unset, invitation emails are not attempted: responder accounts are still
# created without a password and the admin UI offers "Resend invitation" retry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Horizontal scaling (multi-dyno). Leave unset for single-dyno MVP mode.
# When set, rate limits + Socket.IO rooms are shared via Redis.
REDIS_URL=
# Must be 1 unless REDIS_URL is set; production refuses to boot with
# WEB_CONCURRENCY > 1 and no REDIS_URL.
WEB_CONCURRENCY=1
