{
    "name": "sibuyan-accident-alert-server",
    "version": "1.0.0",
    "description": "Backend API for Sibuyan Island Accident Alert and Mapping System",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "seed": "node seeds/adminSeed.js",
        "seed:responders": "node seeds/seedResponders.js",
        "download:barangay-boundaries": "node scripts/downloadSibuyanBarangayBoundaries.js",
        "import:barangay-boundaries": "node scripts/importSibuyanBarangayBoundaries.js",
        "reset:responders": "node seeds/seedResponders.js",
        "migrate:gridfs": "node scripts/migrateMediaToGridFS.js",
        "migrate:remove-system-admins": "node scripts/removeSystemAdmins.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.0.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.7",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "socket.io": "^4.7.2",
        "web-push": "^3.6.6"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "supertest": "^6.3.3"
    },
    "keywords": [
        "accident-reporting",
        "mapping",
        "sibuyan",
        "real-time"
    ],
    "author": "Sibuyan Alert Team",
    "license": "MIT"
}
